@model PaginatedList<ContactMessage>
@{
    ViewData["Title"] = "Contact Messages";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h4 class="fw-bold mb-4">Contact Messages</h4>

<div class="bg-white rounded shadow-sm">
    @if (Model.Any())
    {
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Subject</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var msg in Model)
                {
                    <tr class="@(!msg.IsRead ? "table-warning" : "")">
                        <td><strong>@msg.Name</strong></td>
                        <td>@msg.Email</td>
                        <td>@msg.Subject</td>
                        <td>@msg.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (msg.IsRead)
                            {
                                <span class="badge bg-secondary">Read</span>
                            }
                            else
                            {
                                <span class="badge badge-unread">New</span>
                            }
                        </td>
                        <td>
                            <a href="/Admin/Contacts/Details/@msg.Id" class="btn btn-sm btn-outline-secondary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-inbox fa-2x mb-2"></i>
            <p>No contact messages yet.</p>
        </div>
    }
</div>

@await Html.PartialAsync("_PaginationPartial", new PaginationInfo(Model.PageIndex, Model.TotalPages, Model.TotalCount, "/Admin/Contacts"))
