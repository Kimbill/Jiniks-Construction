@model PaginatedList<JobApplication>
@{
    var job = (JobOpening)ViewBag.Job;
    ViewData["Title"] = "Applications - " + job.Title;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <a href="/Admin/Jobs" class="text-decoration-none text-muted"><i class="fas fa-arrow-left me-1"></i> Back to Jobs</a>
</div>

<h4 class="fw-bold mb-1">Applications</h4>
<p class="text-muted mb-4">For: @job.Title</p>

<div class="bg-white rounded shadow-sm">
    @if (Model.Any())
    {
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>CV</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model)
                {
                    <tr class="@(!app.IsRead ? "table-warning" : "")">
                        <td><strong>@app.Name</strong></td>
                        <td>@app.Email</td>
                        <td><a href="@app.CvUrl" target="_blank" class="text-decoration-none"><i class="fas fa-download me-1"></i>Download</a></td>
                        <td>@app.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (app.IsRead)
                            {
                                <span class="badge bg-secondary">Read</span>
                            }
                            else
                            {
                                <span class="badge badge-unread">New</span>
                            }
                        </td>
                        <td>
                            @if (!app.IsRead)
                            {
                                <form method="post" action="/Admin/Jobs/Applications/MarkRead/@app.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-secondary">Mark Read</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-inbox fa-2x mb-2"></i>
            <p>No applications received yet.</p>
        </div>
    }
</div>

@await Html.PartialAsync("_PaginationPartial", new PaginationInfo(Model.PageIndex, Model.TotalPages, Model.TotalCount, $"/Admin/Jobs/Applications/{job.Id}"))
