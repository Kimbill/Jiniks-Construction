@model PaginatedList<JobOpening>
@{
    ViewData["Title"] = "Manage Jobs";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Job Openings</h4>
    <a href="/Admin/Jobs/Create" class="btn btn-admin">Add Job</a>
</div>

<div class="bg-white rounded shadow-sm">
    <table class="table admin-table mb-0">
        <thead>
            <tr>
                <th>Title</th>
                <th>Location</th>
                <th>Type</th>
                <th>Applications</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model)
            {
                <tr>
                    <td><strong>@job.Title</strong></td>
                    <td>@job.Location</td>
                    <td>@job.Type</td>
                    <td>
                        <a href="/Admin/Jobs/Applications/@job.Id" class="text-decoration-none">
                            @job.Applications.Count applications
                            @{
                                var unread = job.Applications.Count(a => !a.IsRead);
                            }
                            @if (unread > 0)
                            {
                                <span class="badge badge-unread ms-1">@unread new</span>
                            }
                        </a>
                    </td>
                    <td>
                        @if (job.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <a href="/Admin/Jobs/Edit/@job.Id" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                        <form method="post" action="/Admin/Jobs/Delete/@job.Id" class="d-inline" onsubmit="return confirm('Delete this job and all its applications?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_PaginationPartial", new PaginationInfo(Model.PageIndex, Model.TotalPages, Model.TotalCount, "/Admin/Jobs"))
