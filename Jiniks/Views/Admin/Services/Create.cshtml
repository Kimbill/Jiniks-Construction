@model ServiceFormViewModel
@{
    ViewData["Title"] = "Add Service";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <a href="/Admin/Services" class="text-decoration-none text-muted"><i class="fas fa-arrow-left me-1"></i> Back to Services</a>
</div>

<h4 class="fw-bold mb-4">Add Service</h4>

<div class="bg-white rounded shadow-sm p-4">
    <form method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label fw-semibold"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="SortOrder" class="form-label fw-semibold">Display Order</label>
                <input asp-for="SortOrder" type="number" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="IconCssClass" class="form-label fw-semibold">Icon CSS Class</label>
                <input asp-for="IconCssClass" class="form-control" placeholder="e.g. fas fa-home" />
                <small class="text-muted">Font Awesome class name</small>
            </div>
            <div class="col-md-6">
                <label asp-for="Image" class="form-label fw-semibold">Image (optional)</label>
                <input asp-for="Image" type="file" class="form-control" accept="image/*" />
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Active</label>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-admin">Create Service</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
