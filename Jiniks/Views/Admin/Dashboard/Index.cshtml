@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h4 class="fw-bold mb-4">Dashboard</h4>

<div class="row g-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-value">@Model.TotalProjects</div>
                    <div class="stat-label">Total Projects</div>
                </div>
                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="fas fa-building"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-value">@Model.TotalServices</div>
                    <div class="stat-label">Total Services</div>
                </div>
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="fas fa-cogs"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-value">@Model.TotalJobs</div>
                    <div class="stat-label">Job Openings</div>
                </div>
                <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="fas fa-briefcase"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <a href="/Admin/Bookings" class="text-decoration-none">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-value">@Model.UnreadBookings</div>
                        <div class="stat-label">Unread Bookings</div>
                    </div>
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="fas fa-calendar-check"></i></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/Admin/Contacts" class="text-decoration-none">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-value">@Model.UnreadContacts</div>
                        <div class="stat-label">Unread Messages</div>
                    </div>
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="fas fa-envelope"></i></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-value">@Model.UnreadApplications</div>
                    <div class="stat-label">New Applications</div>
                </div>
                <div class="stat-icon" style="background-color: rgba(232,122,46,0.1); color: #E87A2E;"><i class="fas fa-file-alt"></i></div>
            </div>
        </div>
    </div>
</div>
