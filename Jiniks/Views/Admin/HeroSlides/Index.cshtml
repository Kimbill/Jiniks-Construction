@model List<HeroSlide>
@{
    ViewData["Title"] = "Hero Slides";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Hero Slides</h4>
    <a href="/Admin/HeroSlides/Create" class="btn btn-admin">Add Slide</a>
</div>

<div class="bg-white rounded shadow-sm">
    <table class="table admin-table mb-0">
        <thead>
            <tr>
                <th>Preview</th>
                <th>Headline</th>
                <th>Order</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var slide in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(slide.BackgroundImageUrl))
                        {
                            <img src="@slide.BackgroundImageUrl" alt="" style="width: 80px; height: 45px; object-fit: cover; border-radius: 4px;" />
                        }
                    </td>
                    <td><strong>@slide.Headline</strong><br /><small class="text-muted">@slide.Subtext</small></td>
                    <td>@slide.SortOrder</td>
                    <td>
                        @if (slide.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <a href="/Admin/HeroSlides/Edit/@slide.Id" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                        <form method="post" action="/Admin/HeroSlides/Delete/@slide.Id" class="d-inline" onsubmit="return confirm('Delete this slide?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
