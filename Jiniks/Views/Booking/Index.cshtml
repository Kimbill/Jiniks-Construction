@model BookingFormViewModel
@{
    ViewData["Title"] = "Book a Consultation";
}

<div class="page-header">
    <div class="container">
        <h1>Book a Consultation</h1>
        <p>Tell us about your project and we will get back to you</p>
    </div>
</div>

<section class="section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 fade-in">
                <div class="bg-white p-4 p-md-5 rounded shadow-sm">
                    <form asp-action="Index" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold">Full Name</label>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="Your full name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="your@email.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold">Phone Number</label>
                                <input asp-for="Phone" class="form-control form-control-lg" placeholder="+234 ..." />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ProjectType" class="form-label fw-semibold">Project Type</label>
                                <select asp-for="ProjectType" class="form-select form-select-lg">
                                    <option value="">Select a project type</option>
                                    <option value="Residential">Residential</option>
                                    <option value="Commercial">Commercial</option>
                                    <option value="Renovation">Renovation</option>
                                    <option value="Industrial">Industrial</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="ProjectType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BudgetRange" class="form-label fw-semibold">Budget Range</label>
                                <select asp-for="BudgetRange" class="form-select form-select-lg">
                                    <option value="@BudgetRange.Under50K">Under $50,000</option>
                                    <option value="@BudgetRange.From50KTo100K">$50,000 - $100,000</option>
                                    <option value="@BudgetRange.From100KTo250K">$100,000 - $250,000</option>
                                    <option value="@BudgetRange.From250KTo500K">$250,000 - $500,000</option>
                                    <option value="@BudgetRange.Above500K">Above $500,000</option>
                                    <option value="@BudgetRange.NotSure">Not Sure</option>
                                </select>
                                <span asp-validation-for="BudgetRange" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Message" class="form-label fw-semibold">Project Details</label>
                                <textarea asp-for="Message" class="form-control" rows="5" placeholder="Describe your project..."></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-orange btn-lg w-100">Submit Booking Request</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
