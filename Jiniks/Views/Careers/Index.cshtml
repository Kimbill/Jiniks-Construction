@model List<JobOpening>
@{
    ViewData["Title"] = "Careers";
}

<div class="page-header">
    <div class="container">
        <h1>Careers</h1>
        <p>Join our team and build something great</p>
    </div>
</div>

<section class="section-padding">
    <div class="container">
        @if (Model.Any())
        {
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    @foreach (var job in Model)
                    {
                        <div class="job-card mb-3 fade-in">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <h5 class="fw-bold mb-1">@job.Title</h5>
                                    <div class="text-muted">
                                        <span class="me-3"><i class="fas fa-map-marker-alt me-1"></i> @job.Location</span>
                                        <span><i class="fas fa-briefcase me-1"></i> @job.Type</span>
                                    </div>
                                </div>
                                <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-orange btn-sm">View & Apply</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-briefcase fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No open positions at the moment</h4>
                <p class="text-muted">Check back later for new opportunities.</p>
            </div>
        }
    </div>
</section>
