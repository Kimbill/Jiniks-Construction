@{
    ViewData["Title"] = "Application Submitted";
}

<section class="section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center fade-in">
                <div class="confirmation-icon">
                    <i class="fas fa-check"></i>
                </div>
                <h2 class="fw-bold mb-3">Application Submitted!</h2>
                <p class="text-muted mb-4">Thank you for your interest in joining Jiniks Construction. We will review your application and be in touch.</p>
                <a asp-controller="Careers" asp-action="Index" class="btn btn-outline-orange me-2">View More Positions</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-orange">Back to Home</a>
            </div>
        </div>
    </div>
</section>
