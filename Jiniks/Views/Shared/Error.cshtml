@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold text-muted">Something went wrong</h1>
    <p class="text-muted mt-3">An unexpected error occurred. Please try again later.</p>
    @if (Model?.ShowRequestId ?? false)
    {
        <p class="text-muted"><small>Request ID: @Model.RequestId</small></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-orange mt-3">Back to Home</a>
</div>
