@{
    ViewData["Title"] = "Message Sent";
}

<section class="section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center fade-in">
                <div class="confirmation-icon">
                    <i class="fas fa-check"></i>
                </div>
                <h2 class="fw-bold mb-3">Message Sent!</h2>
                <p class="text-muted mb-4">Thank you for reaching out. Our team will respond to your message as soon as possible.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-orange">Back to Home</a>
            </div>
        </div>
    </div>
</section>
