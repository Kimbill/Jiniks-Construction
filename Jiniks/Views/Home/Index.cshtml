@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

@if (Model.HeroSlides.Any())
{
    <section class="hero-section d-flex align-items-center" style="margin-top: -76px;">
        @foreach (var slide in Model.HeroSlides)
        {
            <div class="hero-slide" style="background-image: url('@slide.BackgroundImageUrl');">
                <div class="hero-overlay"></div>
            </div>
        }
        <div class="container position-relative" style="z-index: 3;">
            <div class="hero-content">
                @{
                    var firstSlide = Model.HeroSlides.First();
                }
                <h1>@firstSlide.Headline</h1>
                <p>@firstSlide.Subtext</p>
                <a href="@firstSlide.CtaUrl" class="btn btn-orange btn-lg">@firstSlide.CtaText</a>
            </div>
        </div>
    </section>
}

<section class="section-padding bg-white">
    <div class="container text-center">
        <h2 class="section-title fade-in">Our Services</h2>
        <p class="section-subtitle fade-in">Delivering quality across every phase of construction</p>
        <div class="row g-4">
            @foreach (var service in Model.Services)
            {
                <div class="col-md-6 col-lg-4 fade-in">
                    <div class="service-card">
                        @if (!string.IsNullOrEmpty(service.IconCssClass))
                        {
                            <div class="icon"><i class="@service.IconCssClass"></i></div>
                        }
                        <h5>@service.Title</h5>
                        <p>@service.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@if (Model.FeaturedProjects.Any())
{
    <section class="section-padding" style="background-color: var(--bg-light);">
        <div class="container text-center">
            <h2 class="section-title fade-in">Featured Projects</h2>
            <p class="section-subtitle fade-in">A showcase of our finest work</p>
            <div class="row g-4">
                @foreach (var project in Model.FeaturedProjects)
                {
                    <div class="col-md-6 col-lg-4 fade-in">
                        <a asp-controller="Portfolio" asp-action="Details" asp-route-id="@project.Id" class="text-decoration-none">
                            <div class="project-card">
                                <img src="@project.CoverImageUrl" alt="@project.Title" />
                                <div class="project-card-overlay">
                                    <h5>@project.Title</h5>
                                    <span><i class="fas fa-map-marker-alt me-1"></i> @project.Location</span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
            <div class="mt-5 fade-in">
                <a asp-controller="Portfolio" asp-action="Index" class="btn btn-outline-orange">View All Projects</a>
            </div>
        </div>
    </section>
}

<section class="section-padding bg-dark text-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7 fade-in">
                <h2 class="fw-bold" style="font-size: 2.5rem;">Ready to Build Your Vision?</h2>
                <p class="text-white-50 mt-3" style="font-size: 1.15rem;">
                    Let us bring your construction project to life. From concept to completion, we are with you every step.
                </p>
            </div>
            <div class="col-lg-5 text-lg-end mt-4 mt-lg-0 fade-in">
                <a asp-controller="Booking" asp-action="Index" class="btn btn-orange btn-lg">Book a Consultation</a>
            </div>
        </div>
    </div>
</section>
