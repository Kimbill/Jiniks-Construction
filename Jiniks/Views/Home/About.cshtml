@{
    ViewData["Title"] = "About Us";
}

<div class="page-header">
    <div class="container">
        <h1>About Us</h1>
        <p>Learn more about Jiniks Construction and our commitment to excellence</p>
    </div>
</div>

<section class="section-padding">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 fade-in">
                <h2 class="section-title">Building Excellence Since Day One</h2>
                <p class="text-muted mt-3" style="line-height: 1.8;">
                    Jiniks Construction is a premium construction company committed to delivering world-class
                    residential and commercial projects. We combine modern engineering techniques with
                    attention to detail to create structures that stand the test of time.
                </p>
                <p class="text-muted" style="line-height: 1.8;">
                    Our team of skilled engineers, architects, and project managers work together to ensure
                    every project is delivered on time, within budget, and to the highest quality standards.
                </p>
            </div>
            <div class="col-lg-6 fade-in">
                <div class="row g-4 about-stats text-center">
                    <div class="col-6">
                        <div class="p-4 bg-light rounded">
                            <div class="stat-number">150+</div>
                            <div class="stat-label">Projects Completed</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-4 bg-light rounded">
                            <div class="stat-number">10+</div>
                            <div class="stat-label">Years Experience</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-4 bg-light rounded">
                            <div class="stat-number">50+</div>
                            <div class="stat-label">Team Members</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-4 bg-light rounded">
                            <div class="stat-number">98%</div>
                            <div class="stat-label">Client Satisfaction</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding" style="background-color: var(--bg-light);">
    <div class="container text-center">
        <h2 class="section-title fade-in">Our Values</h2>
        <div class="row g-4 mt-4">
            <div class="col-md-4 fade-in">
                <div class="service-card">
                    <div class="icon"><i class="fas fa-shield-alt"></i></div>
                    <h5>Integrity</h5>
                    <p>We operate with honesty and transparency in every project we undertake.</p>
                </div>
            </div>
            <div class="col-md-4 fade-in">
                <div class="service-card">
                    <div class="icon"><i class="fas fa-award"></i></div>
                    <h5>Quality</h5>
                    <p>We never compromise on the quality of materials or workmanship.</p>
                </div>
            </div>
            <div class="col-md-4 fade-in">
                <div class="service-card">
                    <div class="icon"><i class="fas fa-clock"></i></div>
                    <h5>Timeliness</h5>
                    <p>We deliver every project on schedule without sacrificing quality.</p>
                </div>
            </div>
        </div>
    </div>
</section>
